{{template "layout" .}}
{{define "title"}}{{.Data.Title}}{{end}}
{{define "content"}}
{{with .Data}}
<article class="vault-doc">
<nav class="crumbs" aria-label="Breadcrumb"><a href="/vault">Vault</a>{{if .Folder}} / <a href="/vault?folder={{.Folder}}">{{.FolderLabel}}</a>{{end}}</nav>
<h1>{{.Title}}</h1>
<p class="note doc-meta"><code>{{.Path}}</code>{{if .Ago}} &middot; updated <time datetime="{{.ISO}}" title="{{.Abs}}">{{.Ago}}</time>{{end}}</p>
{{if or .GraphHref .MemoriesHref}}<p class="doc-links">{{if .GraphHref}}<a href="{{.GraphHref}}">See in graph</a>{{end}}{{if .MemoriesHref}}<a href="{{.MemoriesHref}}">See memories</a>{{end}}</p>{{end}}
<nav class="subnav" aria-label="View">
  <a href="/vault/{{vpath .Path}}"{{if not .ShowSource}} aria-current="page"{{end}}>Preview</a>
  <a href="/vault/{{vpath .Path}}?view=source"{{if .ShowSource}} aria-current="page"{{end}}>View source</a>
</nav>
{{if .ShowSource}}
<pre class="vault-source" tabindex="0" aria-label="Markdown source of {{.Path}}"><code>{{.Source}}</code></pre>
{{else}}
{{if .Props}}<section aria-labelledby="props-h" class="props-block"><h2 id="props-h" class="sr-only">Properties</h2>
<dl class="props">{{range .Props}}{{if .Value}}<div class="{{if .Nested}}nested{{end}}"><dt>{{.Key}}</dt><dd>{{.Value}}</dd></div>{{else}}<div class="group"><dt>{{.Key}}</dt><dd></dd></div>{{end}}{{end}}</dl></section>{{end}}
<div class="prose">{{.Body}}</div>
{{if .Backlinks}}<section class="backlinks" aria-labelledby="bl-h"><h2 id="bl-h">Backlinks</h2>
<ul>{{range .Backlinks}}<li><a class="wikilink" href="/vault/{{vpath .Path}}">{{.Name}}</a>{{if .Rel}} <span class="note">{{.Rel}}</span>{{end}}</li>{{end}}</ul></section>{{end}}
{{end}}
{{if .Exported}}<p class="note doc-foot">Exported {{.Exported}}</p>{{end}}
</article>
{{end}}
{{end}}
