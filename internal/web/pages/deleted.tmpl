{{define "title"}}Recently deleted{{end}}
{{define "content"}}
{{with .Data}}
<h1>Recently deleted</h1>
<p class="note">Deletions can be restored for 30 days, then they are removed for good.</p>
<ul class="memlist">
{{range .Batches}}
  <li><time datetime="{{.ISO}}" title="{{.Abs}}">{{.Ago}}</time> · {{.Kind}} · {{.Memories}} memories, {{.Entities}} entities
    <form class="inline-form" method="post" action="/memories/restore/{{.ID}}">
      <input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn-secondary">Restore</button></form></li>
{{else}}<li class="note">Nothing to restore.</li>{{end}}
</ul>
<p><a href="/memories">Back to memories</a></p>
{{end}}
{{end}}
