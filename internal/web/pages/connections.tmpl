{{define "title"}}Connections{{end}}
{{define "conn"}}<li>
  <strong>{{.Name}}</strong>
  {{if .Revoked}}<span class="note">Revoked: cannot connect any more</span>{{else}}<span class="note">Active</span>{{end}}
  <span class="note">last used: {{if .LastUsed}}{{.LastUsed}}{{else}}never{{end}}</span>
  <span class="note">written: {{.Written}}</span>
  {{if not .Revoked}}
  <details class="revoke">
    <summary>Revoke&hellip;</summary>
    <form method="post" action="/connections/{{.ID}}/revoke" class="revoke-panel">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
      <p><strong>Revoke {{.Name}}?</strong> It loses access right away and cannot be switched back on. Choose what happens to what it wrote.</p>
      <div class="actions">
        <button class="btn-danger-quiet" name="choice" value="keep">Revoke, keep what it wrote</button>
        {{if .DeleteCount}}<input type="hidden" name="confirm_count" value="{{.DeleteCount}}">
        <button class="btn-danger" name="choice" value="delete">Revoke and delete {{.DeleteCount}} {{if eq .DeleteCount 1}}item{{else}}items{{end}} it wrote</button>{{end}}
      </div>
      {{if .DeleteCount}}<p class="note">Deleted items can be restored for 30 days.</p>{{else}}<p class="note">It has not written anything, so there is nothing to delete.</p>{{end}}
    </form>
  </details>
  {{end}}
</li>{{end}}
{{define "content"}}
{{with .Data}}
<h1>Connections</h1>
<p>Assistants and agents that can read and write your memory.</p>
{{if .Revoked}}
<section class="notice" id="revoke-notice" role="status">
  <p><strong>Revoked {{.Revoked.Name}}.</strong> It can no longer read or write your memory.{{if .Revoked.BatchID}} Deleted {{.Revoked.Items}} {{if eq .Revoked.Items 1}}item{{else}}items{{end}} it wrote. You can restore {{if eq .Revoked.Items 1}}it{{else}}them{{end}} for 30 days; the connection stays revoked.{{end}}</p>
  {{if .Revoked.BatchID}}<form method="post" action="/memories/restore/{{.Revoked.BatchID}}" class="actions">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <input type="hidden" name="next" value="/connections">
    <button class="btn-secondary">Undo delete</button>
  </form>{{end}}
</section>
{{end}}
{{if .WasRestored}}<p class="notice" role="status">Restored what it wrote. The connection stays revoked.</p>{{end}}
{{if .NewToken}}
<section class="notice" id="new-token">
  <h2>New token for {{.NewName}}</h2>
  <p>Copy it now. It is shown only once.</p>
  <p><code id="new-token-value">{{.NewToken}}</code></p>
</section>
{{end}}
{{if and .Error (eq .ErrField "")}}<p class="error" role="alert"><strong>{{.Error}}</strong></p>{{end}}
<h2>Assistants</h2>
<ul class="conns">
{{range .Assistants}}{{template "conn" .}}{{else}}<li>None yet.</li>{{end}}
</ul>
<h2>Agent tokens</h2>
<ul class="conns">
{{range .Agents}}{{template "conn" .}}{{else}}<li>None yet.</li>{{end}}
</ul>
<form method="post" action="/connections/tokens" autocomplete="off">
  <input type="hidden" name="csrf" value="{{$.CSRF}}">
  <label>Token name <input name="name" required maxlength="80" placeholder="my agent" value="{{.FormName}}" aria-describedby="err-name"{{if eq .ErrField "name"}} aria-invalid="true"{{end}}></label>
  <p class="field-error" id="err-name" role="alert">{{if eq .ErrField "name"}}{{.Error}}{{end}}</p>
  <button class="btn">Create token</button>
</form>
<h2>Recommended custom instructions</h2>
<p>Paste this into your assistant's custom instructions.</p>
<textarea id="instructions" readonly rows="5">{{.Instructions}}</textarea>
<p><button class="btn-secondary" type="button" id="copy-instructions">Copy</button></p>
<script>
document.getElementById('copy-instructions').addEventListener('click',function(){
var t=document.getElementById('instructions');t.select();
if(navigator.clipboard){navigator.clipboard.writeText(t.value)}else{document.execCommand('copy')}});
</script>
{{end}}
{{end}}
