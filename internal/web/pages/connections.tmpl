{{define "title"}}Connections{{end}}
{{define "conn"}}<li class="conn{{if .Revoked}} is-revoked{{end}}">
  <div class="conn-row">
    <strong class="conn-name">{{.Name}}</strong>
    {{template "status" .Status}}
    <p class="conn-meta">{{if .LastUsed}}Last used <time datetime="{{.LastUsed}}" title="{{.LastUsed}}">{{.LastUsedAgo}}</time>{{end}}{{if .LastUsed}} &middot; {{end}}{{.Written}} {{if eq .Written 1}}memory{{else}}memories{{end}} written</p>
  </div>
  <div class="conn-actions">
  <details class="rename">
    <summary>Rename&hellip;</summary>
    <form method="post" action="/connections/{{.ID}}/rename" class="rename-panel">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
      <label>Name <input name="name" required maxlength="80" value="{{.Name}}"></label>
      <button class="btn-secondary" data-pending="Saving&hellip;">Save name</button>
    </form>
  </details>
  {{if .Revoked}}<form method="post" action="/connections/{{.ID}}/remove">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <button class="btn-secondary" aria-describedby="rm-{{.ID}}">Remove from list</button>
    <span class="note" id="rm-{{.ID}}">Hides it here. Memories it wrote are kept.</span>
  </form>{{end}}
  {{if not .Revoked}}
  <details class="revoke">
    <summary>Revoke&hellip;</summary>
    <form method="post" action="/connections/{{.ID}}/revoke" class="revoke-panel">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
      <p><strong>Revoke {{.Name}}?</strong> It loses access right away and cannot be switched back on. Choose what happens to what it wrote.</p>
      <div class="actions">
        <button class="btn-danger-quiet" name="choice" value="keep">Revoke, keep what it wrote</button>
        {{if .DeleteCount}}<input type="hidden" name="confirm_count" value="{{.DeleteCount}}">
        <button class="btn-danger" name="choice" value="delete">Revoke and delete {{n .DeleteCount}} {{if eq .DeleteCount 1}}item{{else}}items{{end}} it wrote</button>{{end}}
      </div>
      {{if .DeleteCount}}<p class="note">Deleted items can be restored for 30 days.</p>{{else}}<p class="note">It has not written anything, so there is nothing to delete.</p>{{end}}
      <p class="note">After revoking, you can remove it from this list.</p>
    </form>
  </details>
  {{end}}
  </div>
</li>{{end}}
{{define "content"}}
{{with .Data}}
<h1>Connections</h1>
<p class="lede">Assistants, scripts and agents that can read and write your memory.</p>
{{template "setup" $}}
{{if .Revoked}}
<section class="notice" id="revoke-notice" role="status">
  <p><strong>Revoked {{.Revoked.Name}}.</strong> It can no longer read or write your memory.{{if .Revoked.BatchID}} Deleted {{.Revoked.Items}} {{if eq .Revoked.Items 1}}item{{else}}items{{end}} it wrote. You can restore {{if eq .Revoked.Items 1}}it{{else}}them{{end}} for 30 days; the connection stays revoked.{{end}}</p>
  {{if .Revoked.BatchID}}<form method="post" action="/memories/restore/{{.Revoked.BatchID}}" class="actions">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <input type="hidden" name="next" value="/connections">
    <button class="btn-secondary">Undo delete</button>
  </form>{{end}}
</section>
{{end}}
{{if .Notice}}
<section class="notice" role="status">
  <p><strong>{{.Notice.Text}}</strong></p>
  {{if .Notice.UndoID}}<form method="post" action="/connections/{{.Notice.UndoID}}/unremove" class="actions">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <button class="btn-secondary">Undo</button>
  </form>{{end}}
</section>
{{end}}
{{if .WasRestored}}<p class="notice" role="status">Restored what it wrote. The connection stays revoked.</p>{{end}}
{{if .NewToken}}
<section class="notice new-token" id="new-token" role="alert" tabindex="-1" aria-labelledby="new-token-h">
  <h2 id="new-token-h">Key created for {{.NewName}}</h2>
  <p>Copy it now. It is shown only once.</p>
  <p><code id="new-token-value">{{.NewToken}}</code></p>
  <p><button class="btn-secondary js-only" type="button" data-copy="new-token-value" data-copy-label="Copy key">Copy key</button></p>
</section>
{{end}}
{{if and .Error (eq .ErrField "")}}<p class="error" role="alert"><strong>{{.Error}}</strong></p>{{end}}
<section class="section connect-assistant" aria-labelledby="h-connect">
  <h2 id="h-connect">Connect an assistant</h2>
  <p>Add this address to ChatGPT or Claude as a custom connector. They ask you to approve access, and it appears below once connected.</p>
  <div class="copy-row"><code class="mcp-url" id="mcp-url">{{.MCPURL}}</code><button class="btn js-only" type="button" data-copy="mcp-url" data-copy-label="Copy address">Copy address</button><span class="copy-status note" role="status" aria-live="polite"></span></div>
  <ol class="how-to">
    <li><strong>ChatGPT:</strong> open Settings, then Connectors, and add a custom connector with this address.</li>
    <li><strong>Claude:</strong> open Settings, then Connectors, and add a custom connector with this address.</li>
    <li>Approve access when asked. cortex does not see your assistant account.</li>
  </ol>
  <details class="fold">
    <summary>Optional: tell your assistant how to use it</summary>
    <p class="note">Paste this into your assistant's custom instructions so it checks and saves memories on its own.</p>
    <textarea id="instructions" readonly rows="9">{{.Instructions}}</textarea>
    <p><button class="btn-secondary js-only" type="button" data-copy="instructions" data-copy-label="Copy instructions">Copy instructions</button><span class="copy-status note" role="status" aria-live="polite"></span></p>
  </details>
</section>
<section class="section" aria-labelledby="h-assistants">
  <h2 id="h-assistants">Connected assistants</h2>
  <p class="note conn-legend"><strong>Not used yet</strong> turns to <strong>Active</strong> after the first request, and to <strong>Idle</strong> after 30 days without one. <strong>Revoked</strong> can no longer connect.</p>
  <ul class="conns">
  {{range .Assistants}}{{template "conn" .}}{{else}}<li class="conn-empty"><strong>No assistants connected yet.</strong> Follow the steps above. It appears here after it first connects.</li>{{end}}
  </ul>
</section>
<section class="section" aria-labelledby="h-agents">
  <h2 id="h-agents">Scripts and agents</h2>
  {{if .Agents}}<ul class="conns">
  {{range .Agents}}{{template "conn" .}}{{end}}
  </ul>{{end}}
  <details class="fold"{{if or .NewToken .ErrField .Agents}} open{{end}}>
    <summary>For your own scripts and agents</summary>
    <p class="note">Create a private key for code you run yourself. It is shown once, so copy it when it appears.</p>
    <form method="post" action="/connections/tokens" autocomplete="off" class="token-form">
      <input type="hidden" name="csrf" value="{{$.CSRF}}">
      <label>Name <input name="name" required maxlength="80" placeholder="my agent" value="{{.FormName}}" aria-describedby="err-name"{{if eq .ErrField "name"}} aria-invalid="true"{{end}}></label>
      <p class="field-error" id="err-name" role="alert">{{if eq .ErrField "name"}}{{.Error}}{{end}}</p>
      <button class="btn" data-pending="Creating&hellip;">Create key</button>
    </form>
  </details>
</section>
<script nonce="{{$.Nonce}}">
var nt=document.getElementById('new-token');if(nt){nt.focus()}
document.querySelectorAll('[data-copy]').forEach(function(b){
b.addEventListener('click',function(){
var el=document.getElementById(b.dataset.copy);
var text=el.value!==undefined?el.value:el.textContent;
function done(){b.textContent='Copied';var s=b.parentNode.querySelector('.copy-status');if(s)s.textContent='Copied to clipboard';
setTimeout(function(){b.textContent=b.dataset.copyLabel;if(s)s.textContent=''},2000)}
function fallback(){var r=document.createRange();if(el.select){el.select()}else{r.selectNodeContents(el);var g=getSelection();g.removeAllRanges();g.addRange(r)}
try{document.execCommand('copy');done()}catch(e){}}
if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(done,fallback)}else{fallback()}})});
</script>
{{end}}
{{end}}
