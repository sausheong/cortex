{{define "title"}}Memories{{end}}
{{define "content"}}
{{with .Data}}
{{template "memnav" $}}
<h1>Memories</h1>
<p class="lede">{{.TotalFmt}} {{if eq .Total 1}}memory{{else}}memories{{end}}{{if .HasMore}} match{{if eq .Total 1}}es{{end}} your filter{{else}} stored{{end}}.</p>
{{template "setup" $}}
{{if .Undo}}
<section class="notice" id="undo-notice" role="status">
  <p><strong>Deleted {{n .Undo.Count}} {{if eq .Undo.Count 1}}memory{{else}}memories{{end}}.</strong> You can restore {{if eq .Undo.Count 1}}it{{else}}them{{end}} for 30 days.</p>
  <form method="post" action="/memories/restore/{{.Undo.BatchID}}" class="actions">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <input type="hidden" name="next" value="{{.Undo.Next}}">
    <button class="btn">Undo delete</button>
    <a href="/memories/deleted">Recently deleted</a>
  </form>
</section>
{{end}}
{{if .WasRestored}}<p class="notice" role="status">{{if .Restored}}Restored {{.Restored}} {{if eq .Restored 1}}memory{{else}}memories{{end}}.{{else}}Restored.{{end}}</p>{{end}}
{{if and .Error (eq .ErrField "")}}<p class="error" role="alert"><strong>{{.Error}}</strong></p>{{end}}
{{if .Since}}<p class="notice" role="status">Showing only memories added since <time datetime="{{.Since}}">{{.SinceAgo}}</time>. <a href="/memories">Show all memories</a></p>{{end}}
{{if .Entity}}<p class="notice" role="status">Showing only memories that mention <strong>{{if .EntityName}}{{.EntityName}}{{else}}something that is no longer in your graph{{end}}</strong>. <a href="/memories">Show all memories</a>{{if .EntityName}} &middot; <a href="/graph?center={{.Entity}}">Open in Graph</a>{{end}}</p>{{end}}
{{if or .Memories .HasMore .Q .By .From .To .Since .Entity}}<form method="get" action="/memories" class="search" aria-label="Find memories">
  {{if .Entity}}<input type="hidden" name="entity" value="{{.Entity}}">{{end}}
  {{if .Since}}<input type="hidden" name="since" value="{{.Since}}">{{end}}
  <div class="search-row">
    <label>Search <input name="q" type="search" value="{{.Q}}"></label>
    <label>Written by
      <select name="by"><option value="">Anyone</option><option value="none"{{if eq $.Data.By "none"}} selected{{end}}>Added directly</option>
        {{range .ConnOpts}}<option value="{{.ID}}" {{if eq .ID $.Data.By}}selected{{end}}>{{.Label}}</option>{{end}}
      </select></label>
    <button class="btn-secondary" data-pending="Applying&hellip;">Apply</button>
  </div>
  <details class="more"{{if .MoreOpen}} open{{end}}>
    <summary>More filters{{if .MoreOpen}} (on){{end}}</summary>
    <div class="search-row dates">
      <label>From <input name="from" type="date" value="{{.From}}"{{if .RangeErr}} aria-invalid="true" aria-describedby="err-range"{{end}}></label>
      <label>To <input name="to" type="date" value="{{.To}}"{{if .RangeErr}} aria-invalid="true" aria-describedby="err-range"{{end}}></label>
      <label>Sort
        <select name="sort">
          <option value="newest"{{if eq .Sort "newest"}} selected{{end}}>Newest first</option>
          <option value="oldest"{{if eq .Sort "oldest"}} selected{{end}}>Oldest first</option>
        </select></label>
      <label>Per page
        <select name="size">{{range .Sizes}}<option value="{{.}}"{{if eq . $.Data.Size}} selected{{end}}>{{.}}</option>{{end}}</select></label>
      <button class="btn-secondary" data-pending="Applying&hellip;">Apply</button>
    </div>
    <p class="field-error" id="err-range" role="alert">{{.RangeErr}}</p>
    <p class="note" id="tz-hint">Dates are whole days in {{.TZHint}}, and both ends are included.</p>
    <nav class="presets" aria-label="Date presets"><span class="note">Quick range:</span>
      {{range .Presets}}<a href="{{.Href}}"{{if .Current}} aria-current="true" class="on"{{end}}>{{.Label}}</a>{{end}}
    </nav>
  </details>
</form>{{end}}
<form method="post" action="/memories/delete" id="memform">
  <input type="hidden" name="csrf" value="{{$.CSRF}}">
  <input type="hidden" name="scope" value="selected">
  <input type="hidden" name="view" value="{{.ViewQuery}}">
  {{if .Memories}}<div class="seltoolbar" id="seltoolbar">
    <a id="selall" class="selact" href="{{.SelectHref}}">Select all on this page{{if gt .SelCount 0}} ({{.SelCount}}){{end}}</a>
    <span id="selcount" aria-live="polite" class="selcount">{{if .SelectPage}}{{.SelCount}} selected{{end}}</span>
    <button class="btn-danger-quiet selon">Delete selected&hellip;</button>
    <a id="selclear" class="selact selon" href="{{.PageHref}}"{{if not .SelectPage}} hidden{{end}}>Clear selection</a>
    <a id="cleanuplink" class="selact selmore" href="#cleanup">Clean up</a>
    <span class="note js-hide">Tick memories to delete. You confirm the count on the next screen.</span>
  </div>{{end}}
  <div id="memlist" aria-describedby="err-ids">
  {{range .Days}}
    <section class="memday" aria-labelledby="day-{{.ISO}}">
    <h2 class="day" id="day-{{.ISO}}"><time datetime="{{.ISO}}">{{.Label}}</time></h2>
    <ul class="memlist">
    {{range .Rows}}
      <li><label class="mem"><input type="checkbox" name="ids" value="{{.ID}}"{{if $.Data.SelectPage}} checked{{end}}>
        <span class="mem-body"><span class="mem-text">{{.Content}}</span>
        <span class="mem-meta">{{if .New}}<strong class="new">New</strong> &middot; {{end}}<time datetime="{{.ISO}}" title="{{.Abs}}">{{.Ago}}</time>{{if .Who}} &middot; {{.Who}}{{end}}</span></span>
      </label></li>
    {{end}}
    </ul>
    </section>
  {{else}}<ul class="memlist"><li class="empty-state">{{if $.Data.HasMore}}<strong>Nothing matches.</strong> <span class="note">Try fewer filters, or <a href="/memories">clear the search</a>.</span>{{else}}<strong>No memories yet.</strong>
    <span class="note">cortex only remembers what a connected assistant saves. <a href="/connections">Connect an assistant</a>, then ask it to remember something about you.</span>{{end}}</li></ul>{{end}}
  </div>
  <p class="field-error" id="err-ids" role="alert">{{if eq .ErrField "ids"}}{{.Error}}{{end}}</p>
</form>
{{if .Memories}}<nav class="pager" aria-label="Pagination">
  <p class="showing">Showing {{.ShowFmt}} of {{.TotalFmt}}</p>
  {{if .Pages}}<ul class="pages">
    <li>{{if .PrevPage}}<a class="pg-step" rel="prev" href="{{.PrevHref}}">Previous</a>{{else}}<span class="pg-step off" aria-disabled="true">Previous</span>{{end}}</li>
    {{range .Pages}}{{if .Gap}}<li class="gap" aria-hidden="true">&hellip;</li>{{else if .Current}}<li><span class="pg on" aria-current="page"><span class="sr-only">Page </span>{{.N}}</span></li>{{else}}<li><a class="pg" href="{{.Href}}"><span class="sr-only">Page </span>{{.N}}</a></li>{{end}}{{end}}
    <li>{{if .NextPage}}<a class="pg-step" rel="next" href="{{.NextHref}}">Next</a>{{else}}<span class="pg-step off" aria-disabled="true">Next</span>{{end}}</li>
  </ul>{{end}}
</nav>{{end}}
<details class="cleanup section" id="cleanup"{{if or (eq .ErrField "older_than") (eq .ErrField "match")}} open{{end}}>
  <summary>Clean up</summary>
  <p class="note">Deleted memories can be restored for 30 days from <a href="/memories/deleted">Recently deleted</a>. You always see the exact count before anything is deleted.</p>
  <form method="post" action="/memories/delete" class="cleanup-form">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <input type="hidden" name="scope" value="matching">
    <input type="hidden" name="view" value="{{.ViewQuery}}">
    <h2>Delete by rule</h2>
    <label>Written by
      <select name="by"><option value="">Anyone</option>
        {{range .ConnOpts}}<option value="{{.ID}}">{{.Label}}</option>{{end}}
      </select></label>
    <label>Older than (days) <input name="older_than" inputmode="numeric" aria-describedby="err-older"{{if eq .ErrField "older_than"}} aria-invalid="true"{{end}}></label>
    <p class="field-error" id="err-older" role="alert">{{if eq .ErrField "older_than"}}{{.Error}}{{end}}</p>
    <label>Containing text <input name="match" aria-describedby="err-match"{{if eq .ErrField "match"}} aria-invalid="true"{{end}}></label>
    <p class="field-error" id="err-match" role="alert">{{if eq .ErrField "match"}}{{.Error}}{{end}}</p>
    <button class="btn-danger-quiet">Delete matching&hellip;</button>
  </form>
  <form method="post" action="/memories/delete" class="cleanup-form">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <input type="hidden" name="scope" value="all">
    <input type="hidden" name="view" value="{{.ViewQuery}}">
    <input type="hidden" name="all" value="1">
    <h2>Delete everything</h2>
    <p class="note">Clears all {{n .Total}} {{if eq .Total 1}}memory{{else}}memories{{end}}. You type a phrase to confirm.</p>
    <button class="btn-danger-quiet">Delete all memories&hellip;</button>
  </form>
</details>
<script nonce="{{$.Nonce}}">
(function(){
  // Tell the server our UTC offset so date filters mean the viewer's local days.
  try{
    var off=String(new Date().getTimezoneOffset()), m=document.cookie.match(/(?:^|; )cortex_tz=([^;]*)/);
    if(!m||m[1]!==off){
      document.cookie="cortex_tz="+off+"; path=/; max-age=31536000; SameSite=Lax";
      // Reload only if the cookie actually stuck, so blocked cookies cannot loop.
      var back=document.cookie.match(/(?:^|; )cortex_tz=([^;]*)/);
      if(back&&back[1]===off&&/[?&](from|to|range)=/.test(location.search)) location.reload();
    }
  }catch(e){}
})();
(function(){
  var f=document.getElementById("memform"); if(!f) return;
  var bar=document.getElementById("seltoolbar"), out=document.getElementById("selcount");
  function upd(){
    var n=f.querySelectorAll('input[name=ids]:checked').length;
    bar.classList.toggle("has-sel",n>0);
    out.textContent=n?n+" selected":"";
    if(sa) sa.hidden=n===f.querySelectorAll('input[name=ids]').length&&n>0;
  }
  function setAll(v){f.querySelectorAll('input[name=ids]').forEach(function(c){c.checked=v});upd();}
  var sa=document.getElementById("selall"), sc=document.getElementById("selclear");
  if(sa) sa.addEventListener("click",function(e){e.preventDefault();setAll(true);});
  if(sc) sc.hidden=false;
  if(sc) sc.addEventListener("click",function(e){e.preventDefault();setAll(false);});
  f.addEventListener("change",upd); upd();
  var cl=document.getElementById("cleanup"), cll=document.getElementById("cleanuplink");
  if(cl&&cll) cll.addEventListener("click",function(){cl.open=true;});
})();
</script>
{{end}}
{{end}}
