{{define "title"}}Home{{end}}
{{define "content"}}
{{with .Data}}
<h1>Home</h1>
<p class="lede">What cortex knows about you, and what has changed.</p>
{{template "setup" $}}

<section class="home-section" aria-labelledby="about-h">
  <h2 id="about-h">About you</h2>
  {{if .Profile.Err}}<p class="note" role="status">This could not be loaded just now. Reload to try again.</p>
  {{else if .Profile.Ready}}
  <ul class="home-bullets">
    {{range .Profile.Lines}}<li>{{.}}</li>{{end}}
  </ul>
  {{if .Profile.More}}<details class="more">
    <summary>Show {{len .Profile.More}} more</summary>
    <ul class="home-bullets">{{range .Profile.More}}<li>{{.}}</li>{{end}}</ul>
  </details>{{end}}
  <p class="note">Summarised from your memories, {{.Profile.BuiltAt}}.</p>
  {{else}}
  <p>{{if and $.Setup (not $.Setup.Memory)}}Once your assistants have saved a few things, cortex writes a short summary of you here.{{else}}Your summary builds overnight, once cortex has enough saved to go on.{{end}}</p>
  {{end}}
  <p><a href="/graph">Explore your graph</a></p>
</section>

<section class="home-section" aria-labelledby="new-h">
  <h2 id="new-h">{{.New.Heading}}</h2>
  {{if .New.Err}}<p class="note" role="status">This could not be loaded just now. Reload to try again.</p>
  {{else if .New.Empty}}
  <p>{{if and $.Setup (not $.Setup.Memory)}}Nothing yet. Memories your assistants save will appear here, grouped by who saved them.{{else}}{{.New.Empty}}{{end}}</p>
  {{if $.Setup}}{{if $.Setup.Memory}}<p><a href="/memories">All memories</a></p>{{end}}{{else}}<p><a href="/memories">All memories</a></p>{{end}}
  {{else}}
  <ul class="home-groups">
    {{range .New.Groups}}<li>
      <h3 class="group-head"><a href="{{.Href}}">{{.Name}} &middot; {{.Count}} new</a></h3>
      <ul class="home-lines">
        {{range .Items}}<li><span class="line-text">{{.Text}}</span> <time class="note" datetime="{{.ISO}}" title="{{.Abs}}">{{.Ago}}</time></li>{{end}}
      </ul>
    </li>{{end}}
  </ul>
  {{end}}
</section>

<section class="home-section" aria-labelledby="assist-h">
  <h2 id="assist-h">Assistants</h2>
  {{if .Assistants.Err}}<p class="note" role="status">This could not be loaded just now. Reload to try again.</p>
  {{else if not .Assistants.Rows}}
  <p>No assistants are connected yet. <a href="/connections">Connect one</a></p>
  {{else}}
  <ul class="home-rows">
    {{range .Assistants.Rows}}<li>
      <strong class="row-name">{{.Name}}</strong>
      <span class="row-meta">
        {{if eq .Flag "unused"}}<span class="status status-unused"><svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6" stroke-dasharray="2.5 2.5"/></svg>Not used yet</span>
        {{else}}<time datetime="{{.UsedISO}}">{{.Used}}</time>{{if eq .Flag "idle"}} <span class="status status-idle"><svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6"/><path d="M8 4.5V8l2.5 1.5"/></svg>Idle for over 30 days</span>{{end}}{{end}}
        <span class="conn-meta">{{.Written7}} written in the last 7 days</span>
      </span>
    </li>{{end}}
  </ul>
  <p><a href="/connections">Manage connections</a></p>
  {{end}}
</section>

<section class="home-section" aria-labelledby="health-h">
  <h2 id="health-h">Health</h2>
  {{if .Health.Err}}<p class="note" role="status">Some of this could not be loaded just now. Reload to try again.</p>{{end}}
  <ul class="home-rows">
    {{if .Health.MaintState}}<li>
      <strong class="row-name">Nightly maintenance</strong>
      <span class="row-meta">
        {{if eq .Health.MaintState "failed"}}<span class="status status-revoked"><svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><circle cx="8" cy="8" r="6"/><path d="M8 4.8v3.6M8 11v.2"/></svg>Problem.</span>{{end}}
        {{.Health.MaintText}}{{if ne .Health.MaintState "ok"}} <a href="/settings">Open settings</a>{{end}}
      </span>
    </li>{{end}}
    <li>
      <strong class="row-name">AI provider</strong>
      <span class="row-meta">{{.Health.ProviderText}}{{if not .Health.ProviderOK}} <a href="/settings">Open settings</a>{{end}}</span>
    </li>
    <li>
      <strong class="row-name">Storage</strong>
      <span class="row-meta">{{.Health.StorageText}} <a href="/account">Details</a></span>
    </li>
    <li>
      <strong class="row-name">Recently deleted</strong>
      <span class="row-meta">{{.Health.DeletedText}}{{if .Health.DeletedCount}} <a href="/memories/deleted">Review</a>{{end}}</span>
    </li>
  </ul>
</section>
{{end}}
{{end}}
