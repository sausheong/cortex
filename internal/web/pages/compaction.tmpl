{{define "title"}}Compaction{{end}}
{{define "head"}}{{if eq .Data.Status "proposing"}}<noscript><meta http-equiv="refresh" content="3"></noscript>{{end}}{{end}}
{{define "retry"}}<form method="post" action="/memories/compact" class="actions">
  <input type="hidden" name="csrf" value="{{.}}">
  <button class="btn-secondary">Start a new compaction</button>
</form>{{end}}
{{define "content"}}
{{with .Data}}
{{template "memnav" $}}
<h1>Compaction</h1>
{{if .Error}}
<div class="error" role="alert">
  <p><strong>{{.Error}}</strong></p>
  {{if .ErrLink}}<p><a href="{{.ErrLink}}">{{.ErrLinkText}}</a></p>{{end}}
</div>
{{if .CanRetry}}{{template "retry" $.CSRF}}{{end}}
{{end}}
{{if eq .Status "proposing"}}
<p class="lede" id="proposing" role="status">Looking for memories to merge. This page refreshes on its own.</p>
<script nonce="{{$.Nonce}}">
(function(){var nonce=document.currentScript.nonce,t=setInterval(function(){fetch(location.href,{credentials:"same-origin"}).then(function(r){return r.text()}).then(function(h){
var d=new DOMParser().parseFromString(h,"text/html");if(d.getElementById("proposing"))return;
clearInterval(t);document.getElementById("main").innerHTML=d.getElementById("main").innerHTML;
var s=document.getElementById("main").querySelectorAll("script");s.forEach(function(o){var n=document.createElement("script");n.nonce=nonce;n.textContent=o.textContent;o.replaceWith(n)});
document.getElementById("main").focus()}).catch(function(){})},3000)})();
</script>
{{else if eq .Status "ready"}}
{{if .Changes}}
<p class="lede">Review the proposed changes. Nothing changes until you confirm, and the originals are kept for 30 days.</p>
<form method="post" action="/compaction/{{.ID}}/apply">
  <input type="hidden" name="csrf" value="{{$.CSRF}}">
  <div class="toolbar">
    <label class="js-only check"><input type="checkbox" id="select-all"> Select all {{n (len .Changes)}}</label>
    <span class="note" id="selected-count" aria-live="polite"></span>
  </div>
  <div id="changes" aria-describedby="err-select">
  {{range .Changes}}
  <section class="change">
    <label><input type="checkbox" name="idx" value="{{.Index}}"> <strong>{{.Label}}</strong></label>
    <p>Replaces:</p>
    <ul>{{range .Sources}}<li>{{.}}</li>{{end}}</ul>
    <p>With: {{.Result}}</p>
  </section>
  {{end}}
  </div>
  <p class="field-error" id="err-select" role="alert">{{.ErrSelect}}</p>
  <div class="actions">
    <button class="btn">Review selected</button>
    <button class="btn-secondary" name="select" value="all">Review all {{n (len .Changes)}}</button>
  </div>
</form>
<script nonce="{{$.Nonce}}">
(function(){var all=document.getElementById('select-all'),box=document.getElementById('changes'),out=document.getElementById('selected-count');
if(!all||!box)return;var cs=box.querySelectorAll('input[name=idx]');
function upd(){var n=0;cs.forEach(function(c){if(c.checked)n++});out.textContent=n+' of '+cs.length+' selected';all.checked=n===cs.length;all.indeterminate=n>0&&n<cs.length}
all.addEventListener('change',function(){cs.forEach(function(c){c.checked=all.checked});upd()});
cs.forEach(function(c){c.addEventListener('change',upd)});upd()})();
</script>
{{else}}<p><strong>Nothing to merge right now.</strong></p>
<p class="note">Compaction combines memories that say the same thing. It has nothing to suggest yet; try again once your assistants have saved more.</p>
<p class="act"><a href="/memories">Back to memories</a></p>{{end}}
{{else if eq .Status "applied"}}
<section class="notice" role="status">
  <p><strong>Compaction applied.</strong> The originals are kept for 30 days. You can undo it now.</p>
  <form method="post" action="/compaction/{{.ID}}/undo" class="actions">
    <input type="hidden" name="csrf" value="{{$.CSRF}}">
    <button class="btn-secondary">Undo compaction</button>
  </form>
</section>
{{else if eq .Status "undone"}}
<p class="notice" role="status">Compaction undone. Your memories are back as they were.</p>
<p class="act"><a href="/memories">Back to memories</a></p>
{{end}}
{{end}}
{{end}}
