{{define "layout"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{template "title" .}} · cortex</title>
<link rel="stylesheet" href="/static/app.css">
<script>document.documentElement.className="js"</script>
{{block "head" .}}{{end}}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <a class="brand" href="/">cortex</a>
  {{if .SignedIn}}<nav aria-label="Main">
    <a href="/memories" {{.Current "/memories"}}>Memories</a>
    <a href="/graph" {{.Current "/graph"}}>Graph</a>
    <a href="/connections" {{.Current "/connections"}}>Connections</a>
    <a href="/settings" {{.Current "/settings"}}>Settings</a>
    <a href="/account" {{.Current "/account"}}>Account</a>
    <form method="post" action="/logout"><input type="hidden" name="csrf" value="{{.CSRF}}"><button class="link">Sign out</button></form>
  </nav>{{end}}
</header>
<main id="main" tabindex="-1">{{template "content" .}}</main>
<script>
(function(){
// Progressive enhancement: on submit, disable the form's buttons and show the
// clicked one as working, so a slow request cannot be sent twice.
document.addEventListener("submit",function(e){
  var f=e.target,b=e.submitter;
  if(f.dataset.busy){e.preventDefault();return}
  f.dataset.busy="1";f.setAttribute("aria-busy","true");
  var bs=f.querySelectorAll("button:not([type=button])");
  if(b&&b.name){var h=document.createElement("input");h.type="hidden";h.name=b.name;h.value=b.value;f.appendChild(h)}
  setTimeout(function(){bs.forEach(function(x){
    x.disabled=true;
    if(x===b||(!b&&bs.length===1)){x.dataset.label=x.textContent;x.textContent=x.dataset.pending||"Working\u2026"}
  })},0);
});
// Back/forward cache can restore a page mid-submit; reset it.
addEventListener("pageshow",function(e){if(!e.persisted)return;
  document.querySelectorAll("form[data-busy]").forEach(function(f){
    delete f.dataset.busy;f.removeAttribute("aria-busy");
    f.querySelectorAll("button:disabled").forEach(function(x){x.disabled=false;if(x.dataset.label){x.textContent=x.dataset.label}})})});
})();
</script>
</body>
</html>{{end}}
{{define "check"}}<svg aria-hidden="true" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.25"/><path d="m5.5 8.2 1.7 1.7 3.3-3.6"/></svg>{{end}}
{{define "setup"}}{{with .Setup}}
<section class="setup" aria-labelledby="setup-h">
  <h2 id="setup-h">Get started <span class="note">{{.Done}} of 3 done</span></h2>
  <ol class="steps">
    <li class="{{if .Provider}}is-done{{end}}">
      <span class="step-mark">{{if .Provider}}{{template "check"}}<span class="sr-only">Done: </span>{{else}}<span class="sr-only">To do: </span>1{{end}}</span>
      <div><strong>Set up your AI provider</strong>
      <p class="note">cortex uses your own key to read and organise what is saved.{{if and (not .Provider) (ne $.Path "/settings")}} <a href="/settings">Open settings</a>{{end}}</p></div>
    </li>
    <li class="{{if .Connect}}is-done{{end}}">
      <span class="step-mark">{{if .Connect}}{{template "check"}}<span class="sr-only">Done: </span>{{else}}<span class="sr-only">To do: </span>2{{end}}</span>
      <div><strong>Connect an assistant</strong>
      <p class="note">Add cortex to ChatGPT, Claude or your own agent.{{if and .Provider (not .Connect)}} <a href="/connections">Connect one</a>{{end}}</p></div>
    </li>
    <li class="{{if .Memory}}is-done{{end}}">
      <span class="step-mark">{{if .Memory}}{{template "check"}}<span class="sr-only">Done: </span>{{else}}<span class="sr-only">To do: </span>3{{end}}</span>
      <div><strong>Save your first memory</strong>
      <p class="note">Tell your assistant something to remember. It appears on the Memories page.</p></div>
    </li>
  </ol>
</section>{{end}}{{end}}
{{template "layout" .}}

{{define "memnav"}}<nav class="subnav" aria-label="Memories sections">
  <a href="/memories" {{.CurrentSub "/memories"}}>All memories</a>
  <a href="/compaction" {{.CurrentSub "/compaction"}}>Compaction</a>
  <a href="/memories/deleted" {{.CurrentSub "/memories/deleted"}}>Recently deleted</a>
</nav>{{end}}
