{{template "layout" .}}
{{define "title"}}Vault{{end}}
{{define "vaultrows"}}{{with .Data}}
<nav class="subnav vault-tabs" aria-label="Page type">{{range .Tabs}}<a href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>
<p class="note vault-count" role="status" id="vault-count">{{if .Filtered}}{{n .Total}} of {{n .All}} pages{{else}}{{n .All}} pages{{end}}</p>
{{if .Rows}}<ul class="vault-files">
{{range .Rows}}<li><a class="vf" href="/vault/{{vpath .Path}}" title="{{.Path}}">{{.Name}}</a><span class="vf-meta">{{.Type}}{{if .Ago}} &middot; <time datetime="{{.ISO}}" title="{{.Abs}}">{{.Ago}}</time>{{end}}</span></li>
{{end}}</ul>{{else}}
<div class="empty-state">{{if .Filtered}}<strong>No pages match.</strong> <span class="note">Try a shorter name, or <a href="/vault">show every page</a>.</span>{{else}}<strong>The vault is empty.</strong> <span class="note">Pages appear here once an assistant has saved memories about people, organisations or topics.</span>{{end}}</div>{{end}}
{{if or .Prev .Next}}<p class="pager" aria-label="Pages">{{if .Prev}}<a href="/vault?{{if .Query}}{{.Query}}&amp;{{end}}page={{.Prev}}">Previous</a>{{end}}
{{if .Next}}<a href="/vault?{{if .Query}}{{.Query}}&amp;{{end}}page={{.Next}}">Next</a>{{end}}</p>{{end}}
{{end}}{{end}}
{{define "content"}}
{{with .Data}}
<h1>Vault</h1>
<p class="lede">A read-only copy of what cortex knows, as linked notes you can open in Obsidian.</p>
<p class="act"><a href="/vault/download">Download them as a .zip</a></p>
<div class="breakout">
  <form method="get" action="/vault" class="vault-filter" role="search">
    <label>Find a page <input id="vault-q" name="q" type="search" value="{{.Q}}" autocomplete="off" placeholder="Name"></label>
    {{if .Folder}}<input type="hidden" name="folder" value="{{.Folder}}">{{end}}{{if ne .Sort "name"}}<input type="hidden" name="sort" value="{{.Sort}}">{{end}}
    <button class="btn-secondary">Search</button>
  </form>
  <section class="vault-main" id="vault-results" aria-label="Pages">
    {{template "vaultrows" $}}
  </section>
</div>
<script nonce="{{$.Nonce}}">
(function(){
var q=document.getElementById("vault-q"),res=document.getElementById("vault-results");
if(!q||!res||!window.fetch)return;
var t,n=0,form=q.form;
function run(){
  var p=new URLSearchParams(new FormData(form));p.delete("page");
  var u="/vault?"+p.toString(),id=++n;
  fetch(u,{credentials:"same-origin"}).then(function(r){return r.text()}).then(function(h){
    if(id!==n)return;
    var d=new DOMParser().parseFromString(h,"text/html"),r=d.getElementById("vault-results");
    if(r){res.innerHTML=r.innerHTML;history.replaceState(null,"",u)}
  }).catch(function(){});
}
q.addEventListener("input",function(){clearTimeout(t);t=setTimeout(run,200)});
form.addEventListener("submit",function(e){e.preventDefault();run()});
})();
</script>
{{end}}
{{end}}
