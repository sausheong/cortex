{{template "layout" .}}
{{define "title"}}Vault{{end}}
{{define "vaultrows"}}<ul class="vault-files">
{{range .}}<li><a class="vf" href="{{vpath .Path}}">{{.Name}}</a><span class="vf-meta">{{if .Descriptor}}{{.Descriptor}} &middot; {{end}}{{if .Note}}{{.Note}} &middot; {{end}}{{if .Written}}written <time datetime="{{.ISO}}" title="{{.Abs}}">{{.Ago}}</time>{{else}}not written yet{{end}}</span></li>
{{end}}</ul>{{end}}
{{define "content"}}
{{with .Data}}
<h1>Vault</h1>
<p class="lede">One article for each person, project and topic cortex knows well, written from your memories the first time you open it.</p>
{{if not .CanWrite}}<p class="note">Your chat model cannot write articles. Choose another in <a href="/settings">Settings</a>.</p>{{end}}
<p class="act"><a href="/vault/download">Download as a .zip</a></p>
<form method="get" action="/vault" class="vault-filter" role="search">
  <label>Find an article <input id="vault-q" name="q" type="search" value="{{.Q}}" autocomplete="off" placeholder="Name"></label>
  <button class="btn-secondary">Search</button>
</form>
{{if .Recent}}<section class="vault-sec" aria-labelledby="recent-h">
<h2 id="recent-h">Recently changed</h2>
{{template "vaultrows" .Recent}}
</section>{{end}}
{{range $i, $sec := .Sections}}<section class="vault-sec" aria-labelledby="sec-{{$i}}">
<h2 id="sec-{{$i}}">{{$sec.Heading}}</h2>
{{template "vaultrows" $sec.Rows}}
</section>
{{end}}
{{if not .Sections}}<div class="empty-state">{{if .Searching}}<strong>No articles match.</strong> <span class="note">Only people, projects and topics that have an article are searched. <a href="/vault">Show every article</a>.</span>{{else}}<strong>No articles yet.</strong> <span class="note">A person, project or topic gets one once it has {{n .Threshold}} or more memories, or is directly connected to you.</span>{{end}}</div>{{end}}
{{end}}
{{end}}
